<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hope Alive</title>
    <link rel="stylesheet" href="/css/login.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-gH2yIJqKdNHPEq0n4Mqa/HGKIhSkIHeL5AyhkYV8i59U5AR6csBvApHHNl/vI1Bx"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <main class="form-signin w-100 m-auto">
      <form action="/token" method="post">
        <%if(errorMessage){%>
        <div><%=errorMessage%></div>
        <%}%>
        <h2>Change Password!</h2>
        <!-- <h1 class="h3 mb-3 fw-normal">Enter Reset Token</h1> -->

        <div class="form-floating">
          <input
            type="text"
            name="token"
            class="form-control"
            id="token"
            placeholder="Token"
          />
          <label for="floatingPassword">Enter Token</label>
        </div>
        <div class="form-floating">
          <input
            type="password"
            name="password"
            class="form-control"
            id="floatingPassword"
            placeholder="Password"
          />
          <label for="floatingPassword">Enter New Password</label>
        </div>

        <div class="form-floating">
          <input
            type="confirmPassword"
            name="confirmPassword"
            class="form-control"
            id="floatingPassword"
            placeholder="confirm Password"
          />
          <label for="confirmPassword">Confirm Password</label>
        </div>
        <button class="w-100 btn btn-lg btn-primary" type="submit">
          Reset Password
        </button>
        <p class="mt-5 mb-3 text-muted">&copy; Hope Alive Pharmacy</p>
      </form>
    </main>
  </body>
</html>
