<%- include('../includes/header') %>
<div class="container mt-5">
  <h1>Register new user</h1>

  <div class="row">
    <div class="col-sm-8">
      <div class="card">
        <div class="card-body">
          <!-- Makes POST request to /register route -->
          <form action="/createuser" method="POST">
            <div class="form-group">
              <label for="firstname">First Name</label>
              <input type="text" class="form-control" name="firstname" /><br />
              <label for="lastname">Last Name</label>
              <input type="text" class="form-control" name="lastname" /><br />

              <label for="email">Email</label>
              <input type="email" class="form-control" name="username" /><br />
            </div>
            <div class="form-group">
              <label for="password">Password</label>
              <input type="password" class="form-control" name="password" />
            </div>
            <div>
              <label for="roles">Choose a role:</label>

              <select name="role" id="role">
                <option value="admin">Admin</option>
                <option value="user">User</option>
              </select>
            </div>
            <button type="submit" class="btn btn-dark">Register User</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../includes/footer') %>
