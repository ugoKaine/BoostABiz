<%- include('../includes/header') %>

<table>
  <tr>
    <td>Product Name</td>
    <td>Available Quantity</td>
  </tr>
  <tr class="<% if (prod.quantity<50) { %>redAlert<%}%>">
    <% prod.forEach(function(p){%>
     <td>
    <%=p.title%></td>
     <td><%=p.quantity%></td>
     <tr></tr>
     <%})%>
  </tr>
</table>
<%- include('../includes/footer') %>
