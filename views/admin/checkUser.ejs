<%- include('../includes/header') %>

<div class="username">
  <form action="/transactions" method="POST">
  <label for="cashier">Cashier:</label>
  <select name="cashier" id="cashier">
    <option value="">-- All Cashiers --</option>
    <% u.forEach(function(username){ %>
      <option value="<%= username %>"><%= username %></option>
    <% }) %>
  </select>

  <label for="payment">Payment Method:</label>
  <select name="payment" id="payment">
    <option value="">-- All Methods --</option>
    <option value="Cash">Cash</option>
    <option value="Bank Transfer">Bank Transfer</option>
    <option value="P.O.S">P.O.S</option>
  </select>

  <label for="startDate">Start Date:</label>
  <input type="date" name="startDate" id="startDate" />

  <label for="endDate">End Date:</label>
  <input type="date" name="endDate" id="endDate" />

  <button type="submit">Filter</button>
</form>
</div>

<div class="checkUser">
  <table id="salesTable">
    <tr>
      <td>Cashier</td>
      <td>Customer Name</td>
      <td>Phone Number</td>
      <td>Address</td>
      <td>Items Sold</td>
      <td>Grand Total</td>
      <td>Payment Method</td>
      <td>Date</td>
    </tr>

    <% receipt.forEach(function(r){ %>
    <tr>
      <td><%= r.lastname %> <%= r.firstname %></td>
      <td><%= r.customerName %></td>
      <td><%= r.phoneNumber %></td>
      <td><%= r.address %></td>
      <td>
        <% r.receiptField.forEach(function(sale, index){ %>
          <span><%= sale.item %>: <%= sale.quantity %></span>
          <% if (index !== r.receiptField.length - 1) { %>
            <span>,</span>
          <% } else { %>
            <span>.</span>
          <% } %>
        <% }) %>
      </td>
      <td><%= r.grandTotal %></td>
      <td><%= r.paymentMethod %></td>
      <td><%= r.createdAt.toString().substring(0,25) %></td>
    </tr>
    <% }) %>
  </table>

  <div id="underSales">
    <h1>Total sales: <%= totalSales %></h1>
  </div>
</div>
</div>
