<%- include('../includes/header'); -%>
<link rel="stylesheet" href="/css/receipt.css" />
<div class="split left">
  <form id="formP" action="#">
    <div class="form-group">
      <label htmlFor="item-name"> Food Name</label>
            <input
            list="productList"
            id="productInput"
            name="product"
            placeholder="Search product..."
            autocomplete="off"
            oninput="updatePriceFromInput()"
          />

        <datalist id="productList">
          <% prod.forEach(p=>{ %>
            <option data-price="<%=p.price%>" value="<%=p.title%>"></option>
          <%})%>
        </datalist>
    </div>
    <div class="form-group">
      <label htmlFor="quantity"> Quantity </label>
      <input
        type="number"
        name="quantity"
        id="quantity"
        onkeyup="doMath()"
        onclick="doMath()"
        onchange="doMath()"
        autocomplete="off"
      />
    </div>
    <div class="form-group">
      <label htmlFor="price" autocomplete="off"> Price/Qty </label>
      <input type="number" name="price" id="price" readonly/>
    </div>
    <p id="total">Total price:</p>
    <button
      id="addNew"
      class="btn btn-primary"
      type="submit"
      onclick="saveArray(event)"
    >
      Add to List +
    </button>
  </form>
</div>

<div class="split right">
  <div class="centred">
    <table>
      <thead>
        <tr>
          <td>Food Name</td>
          <td>Quantity</td>
          <td>Price/Qty(#)</td>
          <td>Total Price(#)</td>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
    <br />
    <p id="grandTotal"></p>

    <!-- Customer details before payment method -->
    <label for="customerName">Customer Name:</label>
    <input type="text" name="customerName" id="customerName" required />
    <br />

    <label for="phoneNumber">Phone Number:</label>
    <input type="text" name="phoneNumber" id="phoneNumber" required />
    <br />

    <label for="address">Address:</label>
    <input type="text" name="address" id="address" required />
    <br /><br />

    <label for="payment">Payment Method:</label>
    <input type="text" list="paymentM" name="payment" id="payment" />
    <datalist id="paymentM">
      <option value="Cash"></option>
      <option value="Bank Transfer"></option>
      <option value="P.O.S"></option>
    </datalist>

    <br /><br /><br />
<button type="submit" class="btn btn-primary" id="submitReceipt" disabled>
  Generate Receipt
</button>


  </div>
</div>

<script src="/js/receipt.js"></script>

