<%- include('../includes/header'); -%>
<link rel="stylesheet" href="/css/receipt.css" />

<div class="split left">
  <form id="formBooking">
    <div class="form-group">
      <label for="checkIn">Check-In</label>
      <input type="date" id="checkIn" required />
    </div>
    <div class="form-group">
      <label for="checkOut">Check-Out</label>
      <input type="date" id="checkOut" required />
    </div>

    <div class="form-group">
      <label for="roomInput">Available Room</label>
      <select id="roomInput">
        <option value="">Select dates first</option>
      </select>
    </div>

    <div class="form-group">
      <label for="guests">Number of Guests</label>
      <input type="number" id="guests" min="1" value="1" />
    </div>

    <div class="form-group">
      <label>Price per Night</label>
      <input type="number" id="price" readonly />
    </div>

    <p id="total">Total: #0</p>
    <button type="submit" class="btn btn-primary" onclick="saveBooking(event)">Add Booking +</button>
  </form>
</div>

<div class="split right">
  <table>
    <thead>
      <tr>
        <td>Room</td>
        <td>Guests</td>
        <td>Nights</td>
        <td>Price/Night</td>
        <td>Total</td>
        <td>Action</td>
      </tr>
    </thead>
    <tbody></tbody>
  </table>

  <p id="grandTotal"></p>

  <label>Customer Name:</label>
  <input type="text" id="customerName" required />
  <label>Phone Number:</label>
  <input type="text" id="phoneNumber" required />
  <label>Payment Method:</label>
  <input list="paymentList" id="payment" required />
  <datalist id="paymentList">
    <option value="Cash"></option>
    <option value="Bank Transfer"></option>
    <option value="P.O.S"></option>
  </datalist>

  <button id="submitBooking" disabled class="btn btn-primary">Generate Booking</button>
</div>

<script>
let bookings = [];
let grandTotal = 0;

const roomInput = document.getElementById('roomInput');
const checkInInput = document.getElementById('checkIn');
const checkOutInput = document.getElementById('checkOut');
const priceInput = document.getElementById('price');
const guestsInput = document.getElementById('guests');

async function fetchAvailableRooms() {
  if (!checkInInput.value || !checkOutInput.value) {
    roomInput.innerHTML = '<option value="">Select dates first</option>';
    return;
  }

  try {
    const res = await fetch(`/rooms/available?checkIn=${checkInInput.value}&checkOut=${checkOutInput.value}`);
    if (!res.ok) throw new Error('Failed to fetch rooms');
    const rooms = await res.json();

    roomInput.innerHTML = ''; // clear previous options
    if (rooms.length === 0) {
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = 'No rooms available';
      roomInput.appendChild(opt);
      return;
    }

    rooms.forEach(r => {
      const opt = document.createElement('option');
      opt.value = r.name;
      opt.dataset.price = r.price;
      opt.textContent = `${r.name} - ₦${r.price}`;
      roomInput.appendChild(opt);
    });

    updatePrice(); // update price if a room is selected
  } catch (err) {
    console.error(err);
    roomInput.innerHTML = '<option value="">Error loading rooms</option>';
  }
}


function updatePrice() {
  const selected = roomInput.selectedOptions[0];
  if (selected) priceInput.value = selected.dataset.price || 0;
  calculateTotal();
}

function calculateTotal() {
  const nights = Math.ceil((new Date(checkOutInput.value) - new Date(checkInInput.value)) / (1000*60*60*24));
  const total = (parseFloat(priceInput.value) || 0) * (nights || 0);
  document.getElementById('total').textContent = `Total: #${total.toFixed(2)}`;
}

function saveBooking(e) {
  e.preventDefault();
  const roomName = roomInput.value;
  const guests = parseInt(guestsInput.value) || 1;
  const nights = Math.ceil((new Date(checkOutInput.value) - new Date(checkInInput.value)) / (1000*60*60*24));
  const price = parseFloat(priceInput.value);
  const total = price * nights;

  if (!roomName || !checkInInput.value || !checkOutInput.value) return alert('Fill room & dates');

  const exists = bookings.find(b => b.room === roomName);
  if (exists) { exists.guests += guests; exists.total += total; } 
  else bookings.push({ room: roomName, guests, nights, price, total });

  updateTable();
  resetLeftForm();
}

function updateTable() {
  const tbody = document.querySelector('tbody');
  tbody.innerHTML = '';
  grandTotal = 0;
  bookings.forEach(b => {
    grandTotal += b.total;
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${b.room}</td>
      <td>${b.guests}</td>
      <td>${b.nights}</td>
      <td>${b.price}</td>
      <td>${b.total}</td>
      <td><button type="button" onclick="deleteBooking('${b.room}')">Del</button></td>
    `;
    tbody.appendChild(tr);
  });
  document.getElementById('grandTotal').textContent = bookings.length ? `Grand Total: #${grandTotal.toFixed(2)}` : '';
  document.getElementById('submitBooking').disabled = bookings.length === 0;
}

function deleteBooking(room) {
  const index = bookings.findIndex(b => b.room === room);
  if (index !== -1) { bookings.splice(index, 1); updateTable(); }
}

function resetLeftForm() {
  roomInput.value = ''; guestsInput.value = 1; priceInput.value = ''; document.getElementById('total').textContent = 'Total: #0';
}

checkInInput.addEventListener('change', fetchAvailableRooms);
checkOutInput.addEventListener('change', fetchAvailableRooms);
roomInput.addEventListener('change', updatePrice);

document.getElementById('submitBooking').addEventListener('click', async e => {
  e.preventDefault();
  const customerName = document.getElementById('customerName').value.trim();
  const phoneNumber = document.getElementById('phoneNumber').value.trim();
  const payment = document.getElementById('payment').value.trim();
  if (!customerName || !phoneNumber || !payment) return alert('Fill customer info');

  const payload = { bookings, customerName, phoneNumber, payment, checkIn: checkInInput.value, checkOut: checkOutInput.value };
  const res = await fetch('/booking', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) });
  if (!res.ok) { const txt = await res.text(); return alert(txt); }
  const blob = await res.blob();
  window.open(URL.createObjectURL(blob), '_blank');
  setTimeout(()=>window.location.reload(), 500);
});
</script>
